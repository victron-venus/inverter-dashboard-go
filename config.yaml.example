# Inverter Dashboard Configuration
# Copy this file to config.yaml and update with your values
# DO NOT commit config.yaml to version control (it's excluded by .gitignore)

# Telemetry transport (desktop connectionPolicy parity):
# 1) mqtt.host set + broker reachable → Cerbo MQTT (preferred)
# 2) mqtt.host set but unreachable + gateway enabled → IGW failover
#    (probes MQTT every ~60s and switches back when broker answers)
# 3) mqtt.host empty + gateway enabled → IGW-only (no Cerbo dial)
# 4) neither → startup error
#
# Alert banner ack/X works on both: MQTT uses W/.../AcknowledgeAll + SilenceAlarm;
# IGW uses POST /v1/commands/{acknowledge_all_notifications|silence_alarm}.
mqtt:
  host: "192.168.160.150"  # Cerbo/LAN broker ("" to skip MQTT / force IGW when gateway on)
  port: 1883               # MQTT port (usually 1883; 0 when unused)

# Remote inverter-gateway (HTTPS). Used when MQTT is unset or unreachable.
# Polls GET /v1/snapshot. Commands: IGW whitelist only
# (silence_alarm, acknowledge_all_notifications); inverter/cmd/* not on IGW yet.
gateway:
  enabled: false
  url: "https://victron.2560801.xyz"
  access_client_id: ""       # Cloudflare Access service token client id
  access_client_secret: ""   # Cloudflare Access service token client secret
  api_token: ""              # Bearer GATEWAY_API_TOKEN
  poll_interval_seconds: 2

# Web Server Configuration
web:
  port: 8080               # Web dashboard port
  host: "0.0.0.0"          # Bind address (0.0.0.0 for all interfaces)

# Logging Configuration
logging:
  level: "info"            # Log level: debug, info, warn, error
  format: "json"           # Format: json or text

# Cerbo GX / Water / EV Configuration (dbus-pump, dbus-ev, dbus-evcharger via Cerbo MQTT)
# Water and EV data come exclusively from the dbus-* services - no HA entities.
# Set portal_id (or CERBO_PORTAL_ID env) to bootstrap a quiet Cerbo immediately.
# Empty enables passive discovery from native N/<portal>/system/... or device traffic;
# a silent broker still requires an explicit portal_id. inverter/portal is optional.
# All native telemetry is scoped to the configured or first discovered portal.
cerbo:
  portal_id: ""              # VRM portal ID of your Cerbo GX
  tank_instance: 21          # com.victronenergy.tank.ha_tank<N>
  pump_instance: 1           # com.victronenergy.pump.startstop<N> (Water pump)
  valve_instance: 2          # com.victronenergy.pump.startstop<N> (City valve)
  ev_instance: 22            # com.victronenergy.ev.<name> (vehicle SOC, charging watts)
  evcharger_instance: 40     # com.victronenergy.evcharger<N> (wallbox power)

# Home Assistant Configuration (Optional)
# Configure to enable direct Home Assistant integration
homeassistant:
  url: "http://10.0.0.58:8123"  # Your HA URL
  token: "your-long-lived-ha-token"
  poll_interval_seconds: 12  # How often to poll HA for state

  # Boolean entities (on/off switches from HA)
  boolean_entities:
    only_charging: "input_boolean.only_charging"
    no_feed: "input_boolean.no_feed"
    house_support: "input_boolean.house_support"
    charge_battery: "input_boolean.charge_battery"
    do_not_supply_charger: "input_boolean.do_not_supply_charger"
    set_limit_to_ev_charger: "input_boolean.set_limit_to_ev_charger"
    minimize_charging: "input_boolean.minimize_charging"

  # Switch entities for home automation buttons
  # Format: key: [entity_id, "Display Label"]
  switch_entities:
    home_recliner: ["switch.recliner_recliner", "Recliner"]
    home_garage: ["switch.garage_opener_l", "Garage"]
    laundry_outlet: ["switch.laundry_zigbee_switch", "Laundry"]
    garage_light: ["light.garage", "Garage light"]
    heater: ["switch.heater_l", "Heater"]

  # Appliance entities for timers and power monitoring
  # These are polled from HA instead of MQTT when configured
  appliance_entities:
    dishwasher_running: "binary_sensor.dishwasher_running"
    dishwasher_duration: "sensor.dishwasher_duration"
    washer_time: "sensor.washer_remaining_time"
    dryer_time: "sensor.dryer_remaining_time"
  sensor_entities:
    # Victron telemetry is read directly from Cerbo MQTT: grid/consumption L1-L3,
    # battery SOC/V/I/P, MPPT/PV, VE.Bus state/setpoint, circuits, water and EV.
    # inverter-control remains the source for daily_stats, solar_forecast,
    # ess_mode and control flags. Configure HA-only household sensors here.

# Optional: Add custom UI configuration
ui:
  theme: "light"  # dark or light
  refresh_rate: 0.33  # WebSocket update rate in seconds
