# Copy to config.yaml in the server's working directory; chmod 600 config.yaml.
# Replace example domains/IDs before starting. Never commit real credentials.
# Existing installations: preserve your own entity inventory and configuration.

mqtt:
  host: "mqtt.example.net" # Your Cerbo/LAN broker; empty string for IGW-only
  port: 1883

# HTTPS inverter-gateway. Explicit GATEWAY_* environment values override YAML.
# MQTT is preferred when both transports are configured. Commands additionally
# require current source ownership, supported capability and fresh observations.
gateway:
  enabled: false
  url: "https://gateway.example.net"
  access_client_id: ""     # Optional Cloudflare Access pair
  access_client_secret: ""
  api_token: ""
  poll_interval_seconds: 2

web:
  host: "127.0.0.1" # Use a trusted HTTPS proxy for remote access
  port: 8080

cerbo:
  portal_id: "" # Configure your portal to bootstrap a quiet MQTT broker
  tank_instance: 21
  pump_instance: 1
  valve_instance: 2
  ev_instance: -1        # -1 discovers; >=0 pins the exact vehicle instance
  evcharger_instance: -1 # -1 discovers; >=0 pins the exact wallbox instance

# Optional Home Assistant. Uncomment and configure only if needed.
# All entity names below are illustrative, not an installation inventory.
# homeassistant:
#   url: "https://ha.example.net"
#   token: "" # Supply your private token here; protect this file
#   direct_controls: false # Enable deliberately after reviewing configured targets
#   poll_interval_seconds: 12
#   switch_entities: [] # No Home buttons by default
#   # Replace [] above with your ordered list; preserve your existing list:
#   #   - key: home_example
#   #     entity: switch.example
#   #     label: Example
#   #     order: 10
#   #     enabled: true
#   boolean_entities: {} # Legacy controller-flag mappings; usually unnecessary
#   appliance_entities: {}
#   # Example keys: washer_time, washer_power, dryer_time, dryer_power,
#   # dishwasher_running, dishwasher_duration, dishwasher_power
#   vue_sensors: {} # Display label -> sensor entity ID
#   filtered_entities:
#     covers: []
#     media_players: []
#     scenes: []
#     numbers: []
#     sensors: []
#     weather: ""

# Environment-only options include DASHBOARD_SECRET, WEB_PUSH_ENABLED,
# WEB_PUSH_DATA_DIR, WEB_PUSH_SUBJECT, INVERTER_DASHBOARD_SETTINGS_FILE,
# SELF_UPDATE_ENABLED, CAMERA_TOPIC and LOG_FORMAT. See docs/configuration.md.
# Do not add logging/ui blocks here: the Go loader does not consume them.
