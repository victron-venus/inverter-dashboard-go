{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "custom.jsonata",
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "gomod",
    "npm",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    "security/provider/**",
    "build-support/tls-armv7/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "description": "Generated locks are updated by pip-compile through their recorded source inputs; never edit the output pins independently.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "scripts/requirements-security-tools.txt"
      ],
      "enabled": false
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      "security/provider/**",
      "build-support/tls-armv7/**",
      "scripts/requirements-security-tools.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^scripts/requirements\\-security\\-tools\\.txt$/"
    ]
  }
}
